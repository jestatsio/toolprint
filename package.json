{
  "name": "toolprint",
  "version": "0.4.0",
  "description": "package-lock.json for MCP trust — scan MCP servers and skill bundles for tool poisoning, secret leaks, and silent rug-pulls, with a committed, reviewable lockfile. CLI, GitHub Action, and MCP server (Claude Code, Codex, Claude Desktop plugins).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "scanner",
    "lockfile",
    "rug-pull",
    "supply-chain",
    "ai-agents",
    "agent-skills",
    "prompt-injection"
  ],
  "license": "Apache-2.0",
  "author": "JEStats",
  "type": "module",
  "bin": {
    "toolprint": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jestatsio/toolprint.git"
  },
  "bugs": {
    "url": "https://github.com/jestatsio/toolprint/issues"
  },
  "homepage": "https://jestatsio.github.io/toolprint/",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TOOLPRINT_E2E=1 vitest run test/e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "package:plugins": "npm run build && node scripts/package-plugins.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "mcpName": "io.github.jestatsio/toolprint"
}
